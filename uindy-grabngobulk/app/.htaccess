Options -Indexes
RewriteEngine On

# Pass SimpleSAMLphp requests through untouched
RewriteRule ^simplesaml/ - [L]

# Pass admin section through untouched
RewriteRule ^admin/ - [L]

# Pass internal/AJAX endpoints through untouched
RewriteRule ^place_order\.php$  - [L]
RewriteRule ^order_status\.php$ - [L]
RewriteRule ^set_lang\.php$     - [L]
RewriteRule ^auth/             - [L]

# Clean URL rewrites (internal only)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^menu$      menu.php       [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^my-orders$ my_order.php   [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^login$     auth/login.php [L]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^logout$    logout.php     [L]

# Redirect direct .php access to clean URLs
RewriteCond %{THE_REQUEST} "\.php"
RewriteRule ^menu\.php$       /menu      [R=301,L]

RewriteCond %{THE_REQUEST} "\.php"
RewriteRule ^my_order\.php$   /my-orders [R=301,L]

RewriteCond %{THE_REQUEST} "\.php"
RewriteRule ^logout\.php$     /logout    [R=301,L]
